# ==========================================
# WhatsApp Admin Bot - Environment Variables
# ==========================================

# Método de Conexão: "qr" (QR Code) ou "code" (Pairing Code)
CONNECTION_METHOD=qr

# Número do Bot (necessário apenas se CONNECTION_METHOD=code, formato: 5511999999999)
BOT_NUMBER=

# Número do Dono (Super Admin do sistema, formato: 5511999999999)
OWNER_NUMBER=5511999999999

# (Opcional) LID do Dono para grupos modernos com anonimização de número (ex: 123456789012345)
OWNER_LID=

# Prefixo padrão para comandos nos grupos
DEFAULT_PREFIX=!

# Idioma padrão inicial ("pt", "es" ou "en")
DEFAULT_LANG=pt

# Modo de autorização de grupos ("owner" = apenas dono pode ativar, "admin" = qualquer admin do grupo)
AUTH_MODE=owner

# Permitir respostas a comandos no privado (DM) para usuários comuns (true/false)
# RECOMENDADO: false para máxima proteção Anti-Ban
ALLOW_PRIVATE_CMDS=false

# Confirmação de Leitura Anti-Ban sob resposta (true/false)
# RECOMENDADO: true para humanização cirúrgica (marca como lida exclusivamente a mensagem a que o bot está respondendo)
# false = Máxima discrição de rede (tiques cinzas eternos, zero pacotes de recibo enviados à Meta)
MARK_READ_ON_REPLY=true

# Fuso horário para os agendamentos automáticos (!horarios)
TIMEZONE=America/Sao_Paulo

# Nível de Log do Pino ("fatal", "error", "warn", "info", "debug", "trace", "silent")
LOG_LEVEL=warn

# ==========================================
# Agente de Inteligência Artificial (Hermes + DeepSeek Oficial)
# ==========================================
AI_ENABLED=true
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=300
AI_TEMPERATURE=0.3
# Limite de chamadas à IA por grupo/hora (trava de custo)
AI_MAX_CALLS_PER_HOUR=60

# ==========================================
# Backup Automático Offsite (Telegram)
# ==========================================
# Token do bot do Telegram (crie um em @BotFather)
BACKUP_TELEGRAM_TOKEN=
# ID do chat que receberá o backup (ex: seu "Mensagens Salvas" ou um canal)
BACKUP_TELEGRAM_CHAT_ID=
# Horário do backup diário — fuso do servidor (DisCloud usa UTC)
BACKUP_HOUR=4
BACKUP_MINUTE=0

# ==========================================
# Integração com o site (entrada automática por link + saída com carência de 24h)
# ==========================================
# Ativa o receptor HTTP que o site (Vercel) chama após o Pix aprovado
SITE_BRIDGE_ENABLED=false
# Mesmo valor de BOT_INTERNAL_SECRET configurado na Vercel (mín. 24 caracteres; gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
BOT_INTERNAL_SECRET=
# Token de produção do Mercado Pago: o bot reconfere o pagamento por conta própria (não confia só no site)
MP_ACCESS_TOKEN=
# Escuta apenas local por padrão; exponha via Cloudflare Tunnel/Nginx com HTTPS (não abra a porta direto)
SITE_BRIDGE_HOST=127.0.0.1
SITE_BRIDGE_PORT=3000
# Tetos de entrada em grupos novos (excedente espera na fila; renovações não contam)
SITE_MAX_JOINS_PER_HOUR=6
SITE_MAX_JOINS_PER_DAY=20
# Link de renovação mostrado nos avisos de D-1 e na despedida
SITE_URL=https://hermes.hewhotries.tech
# true = também sai de grupos cadastrados manualmente quando vencerem + 24h (padrão false: só grupos vendidos pelo site)
AUTO_LEAVE_ALL_EXPIRED=false