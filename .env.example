# ==========================================
# WhatsApp Admin Bot - Environment Variables
# ==========================================

# Método de Conexão: "qr" (QR Code) ou "code" (Pairing Code)
CONNECTION_METHOD=qr

# Número do Bot (necessário apenas se CONNECTION_METHOD=code, formato: 5511999999999)
BOT_NUMBER=

# Número do Dono (Super Admin do sistema, formato: 5511999999999)
OWNER_NUMBER=5511999999999

# (Opcional) LID do Dono para grupos modernos com anonimização de número (ex: 123456789012345)
OWNER_LID=

# Prefixo padrão para comandos nos grupos
DEFAULT_PREFIX=!

# Idioma padrão inicial ("pt", "es" ou "en")
DEFAULT_LANG=pt

# Modo de autorização de grupos ("owner" = apenas dono pode ativar, "admin" = qualquer admin do grupo)
AUTH_MODE=owner

# Permitir respostas a comandos no privado (DM) para usuários comuns (true/false)
# RECOMENDADO: false para máxima proteção Anti-Ban
ALLOW_PRIVATE_CMDS=false

# Fuso horário para os agendamentos automáticos (!horarios)
TIMEZONE=America/Sao_Paulo

# Nível de Log do Pino ("fatal", "error", "warn", "info", "debug", "trace", "silent")
LOG_LEVEL=warn

# ==========================================
# Agente de Inteligência Artificial (Hermes + DeepSeek / OpenRouter / Groq)
# ==========================================
AI_ENABLED=true
AI_PROVIDER=deepseek
AI_BASE_URL=https://api.deepseek.com
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MAX_TOKENS=60
AI_TEMPERATURE=0.6

# Fallback Gratuito via OpenRouter (ativa automaticamente se DeepSeek estiver sem saldo)
# Crie sua chave gratuita em: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-4-31b-it:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# (Opcional) Alternativa Gratuita via Groq (Llama 3.3 70B ultra rápida)
# Crie sua chave gratuita em: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
